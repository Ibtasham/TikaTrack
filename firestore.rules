rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidTimestampOnCreate() {
      return incoming().createdAt is timestamp
        && incoming().updatedAt is timestamp
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
    }

    function isValidTimestampOnUpdate() {
      return incoming().createdAt == existing().createdAt
        && incoming().updatedAt is timestamp
        && incoming().updatedAt == request.time;
    }

    // 3. Entity Validators (called on both create and update)
    function isValidPrivateAccount(data, userId) {
      return data.keys().hasAll(['ownerUid', 'email', 'displayName', 'languagePreference', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'email', 'displayName', 'languagePreference', 'createdAt', 'updatedAt'])
        && data.ownerUid == userId
        && data.ownerUid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.languagePreference in ['en', 'bn']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPublicProfile(data, userId) {
      return data.keys().hasAll(['ownerUid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'displayName', 'createdAt', 'updatedAt'])
        && data.ownerUid == userId
        && data.ownerUid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFamilyProfile(data, userId, profileId) {
      return data.keys().hasAll(['id', 'ownerUid', 'name', 'dateOfBirth', 'events', 'growth', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerUid', 'name', 'dateOfBirth', 'relationship', 'gender', 'events', 'growth', 'createdAt', 'updatedAt'])
        && data.id == profileId
        && isValidId(data.id)
        && data.ownerUid == userId
        && data.ownerUid == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.dateOfBirth is string && data.dateOfBirth.size() == 10 && data.dateOfBirth.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (!('relationship' in data) || data.relationship in ['self', 'child', 'spouse', 'parent', 'sibling', 'other'])
        && (!('gender' in data) || data.gender in ['female', 'male', 'other'])
        && data.events is list && data.events.size() <= 250
        && (data.events.size() == 0 || data.events[0] is map)
        && data.growth is list && data.growth.size() <= 250
        && (data.growth.size() == 0 || data.growth[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudioNote(data, userId, noteId) {
      return data.keys().hasAll(['id', 'ownerUid', 'title', 'summary', 'modelUsed', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerUid', 'title', 'summary', 'modelUsed', 'createdAt', 'updatedAt'])
        && data.id == noteId
        && isValidId(data.id)
        && data.ownerUid == userId
        && data.ownerUid == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 4000
        && data.modelUsed is string && data.modelUsed.size() >= 1 && data.modelUsed.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Matched Collections
    match /users/{userId} {
      allow read, write: if false;

      match /private/{docId} {
        allow get: if isValidId(userId) && docId == 'account' && isOwner(userId);
        allow create: if isValidId(userId) && docId == 'account' && isOwner(userId)
          && isValidPrivateAccount(incoming(), userId)
          && isValidTimestampOnCreate();
        allow update: if isValidId(userId) && docId == 'account' && isOwner(userId)
          && isValidPrivateAccount(incoming(), userId)
          && incoming().ownerUid == existing().ownerUid
          && isValidTimestampOnUpdate()
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'languagePreference', 'updatedAt']);
        allow delete: if isValidId(userId) && docId == 'account' && isOwner(userId);
      }

      match /public/{docId} {
        allow get: if isValidId(userId) && docId == 'profile' && isOwner(userId);
        allow create: if isValidId(userId) && docId == 'profile' && isOwner(userId)
          && isValidPublicProfile(incoming(), userId)
          && isValidTimestampOnCreate();
        allow update: if isValidId(userId) && docId == 'profile' && isOwner(userId)
          && isValidPublicProfile(incoming(), userId)
          && incoming().ownerUid == existing().ownerUid
          && isValidTimestampOnUpdate()
          && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);
        allow delete: if isValidId(userId) && docId == 'profile' && isOwner(userId);
      }

      match /familyProfiles/{profileId} {
        allow get: if isValidId(userId) && isValidId(profileId) && isOwner(userId)
          && existing().ownerUid == request.auth.uid;
        allow list: if isValidId(userId) && isOwner(userId)
          && existing().ownerUid == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(profileId) && isOwner(userId)
          && isValidFamilyProfile(incoming(), userId, profileId)
          && isValidTimestampOnCreate();
        allow update: if isValidId(userId) && isValidId(profileId) && isOwner(userId)
          && isValidFamilyProfile(incoming(), userId, profileId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().id == existing().id
          && isValidTimestampOnUpdate()
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'dateOfBirth', 'relationship', 'gender', 'events', 'growth', 'updatedAt'])
          );
        allow delete: if isValidId(userId) && isValidId(profileId) && isOwner(userId)
          && existing().ownerUid == request.auth.uid;
      }

      match /studioNotes/{noteId} {
        allow get: if isValidId(userId) && isValidId(noteId) && isOwner(userId)
          && existing().ownerUid == request.auth.uid;
        allow list: if isValidId(userId) && isOwner(userId)
          && existing().ownerUid == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(noteId) && isOwner(userId)
          && isValidStudioNote(incoming(), userId, noteId)
          && isValidTimestampOnCreate();
        allow update: if isValidId(userId) && isValidId(noteId) && isOwner(userId)
          && isValidStudioNote(incoming(), userId, noteId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().id == existing().id
          && isValidTimestampOnUpdate()
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'summary', 'modelUsed', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(noteId) && isOwner(userId)
          && existing().ownerUid == request.auth.uid;
      }
    }
  }
}
