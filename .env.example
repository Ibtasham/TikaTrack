# Server-side Gemini API key for /api/tikabot/* and Live Voice (/ws/live-voice)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public base URL where the application is hosted (used for callbacks and origin checks)
APP_URL="MY_APP_URL"

# Google Maps Platform JavaScript & Places API key (optional; enables interactive centres map)
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# Web Push VAPID keys (optional — auto-generated and persisted locally if omitted)
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:reminders@tikatrack.app"

# Optional Cloud SQL PostgreSQL connection (defaults to SQLite/local JSON fallback if omitted)
# SQL_HOST=""
# SQL_PORT="5432"
# SQL_USER=""
# SQL_PASSWORD=""
# SQL_DATABASE=""

# Optional Firebase Web App overrides (falls back to firebase-applet-config.json when omitted)
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""
# VITE_FIREBASE_DATABASE_ID=""
